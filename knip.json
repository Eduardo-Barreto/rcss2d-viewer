{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/*.test.{ts,tsx}",
    "src/test/matchers.d.ts",
    "relay/main.ts",
    "e2e/live-server.ts",
    "relay/**/*.test.ts",
    "src/export/headless.ts",
    "src/types/gifenc.d.ts",
    "scripts/clip.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "relay/**/*.ts", "e2e/**/*.ts"],
  "ignore": ["src/components/ui/**"],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "@fontsource-variable/geist",
    "@fontsource-variable/geist-mono",
    "shadcn",
    "react-hook-form",
    "@hookform/resolvers"
  ],
  "ignoreBinaries": ["ffmpeg", "scripts/clip.ts"]
}
