# Copy to .env and fill in. Only VITE_-prefixed vars reach the client bundle.
# Vite exposes these on import.meta.env.

# Example: base URL for an internal API the dashboard talks to.
# VITE_API_URL=https://api.internal.example.com

# BASE_PATH is set by CI at build time (/<repo>/ for GitHub Pages).
# Leave it unset locally so the app serves from "/".
